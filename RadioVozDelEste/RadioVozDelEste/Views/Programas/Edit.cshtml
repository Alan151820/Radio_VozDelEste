@model RadioVozDelEste.Models.Programas

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Editar Programa</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="card p-4">
        <div class="card-header mb-3">
            Editar Programa
        </div>

        @using (Html.BeginForm("Edit", "Programas", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.ProgramaID)

            <div class="mb-3">
                @Html.LabelFor(m => m.Nombre, new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", placeholder = "Nombre del programa" })
                @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.Label("Imagen actual", new { @class = "form-label fw-bold d-block" })
                @if (!string.IsNullOrEmpty(Model.Imagen))
                {
                    <img src="@Url.Content("~/" + Model.Imagen)" alt="Imagen actual" class="img-programa mb-2" />
                }
                <input type="file" name="Imagen" class="form-control" accept="image/*" />
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Descripcion, new { @class = "form-label fw-bold" })
                @Html.TextAreaFor(m => m.Descripcion, 5, 50, new { @class = "form-control", placeholder = "Descripción del programa" })
                @Html.ValidationMessageFor(m => m.Descripcion, "", new { @class = "text-danger" })
            </div>

            <div class="btn-group mt-3">
                <button type="submit" class="btn btnGuardar">Guardar</button>
                @Html.ActionLink("Cancelar","Programas", "Index", null, new { @class = "btn btn-secondary" })
            </div>
        }
    </div>
</body>
</html>

<style>
    body {
        background-color: #f8f9fa;
        padding: 2rem;
    }

    .card {
        max-width: 600px;
        margin: 2rem auto;
        box-shadow: 0 4px 8px rgba(0,0,0,.05);
        border-radius: 0.5rem;
        background: white;
    }

    .card-header {
        font-weight: 700;
        font-size: 1.5rem;
        color: #0d6efd;
    }

    .form-label {
        color: #495057;
    }

    .img-programa {
        max-width: 200px;
        border-radius: 0.5rem;
        display: block;
    }

    .btn-group a {
        margin-left: 0.5rem;
    }
    .btnGuardar {
        background-color: #a0a51c
    }

        .btnGuardar:hover {
            background-color: #8d8605
        }
</style>
