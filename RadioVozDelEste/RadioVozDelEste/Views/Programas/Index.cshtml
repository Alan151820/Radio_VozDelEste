@model List<RadioVozDelEste.Models.Programas>


<div class="container mt-5">
    <h2 class="titulo-tabla">Listado de Programas</h2>

    <div class="table-responsive tabla-programas">
        <table class="table align-middle table-hover mb-0">
            <thead>
                <tr>
                    <th>Imagen</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var programa in Model)
                {
                    <tr>
                        <td class="text-center">
                            <img src="@Url.Content(programa.Imagen)" class="img-redonda" alt="Foto de @programa.Nombre" />
                        </td>
                        <td>@programa.Nombre</td>
                        <td class="desc-recortada" title="@programa.Descripcion">@programa.Descripcion</td>
                        <td class="acciones">
                            @Html.ActionLink("Editar", "Edit", new { id = programa.ProgramaID }) |
                            @Html.ActionLink("Detalles", "Details", new { id = programa.ProgramaID }) |
                            @Html.ActionLink("Eliminar", "Delete", new { id = programa.ProgramaID })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<style>
    .tabla-programas {
        background-color: #fff;
        border-radius: 12px;
        box-shadow: 0 6px 24px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

        .tabla-programas th {
            background-color: #0d6efd;
            color: white;
            font-weight: 600;
            text-align: center;
            vertical-align: middle;
            font-size: 16px;
        }

        .tabla-programas td {
            vertical-align: middle;
            font-size: 15px;
            color: #333;
            text-align: center; 
        }

    .img-redonda {
        width: 70px;
        height: 70px;
        object-fit: cover;
        border-radius: 50%;
        border: 2px solid #dee2e6;
        transition: transform 0.3s ease;
    }

        .img-redonda:hover {
            transform: scale(1.05);
        }

    .desc-recortada {
        max-width: 300px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .acciones a {
        margin-right: 8px;
        text-decoration: none;
        color: #0d6efd;
        font-weight: 500;
        transition: color 0.2s ease;
    }

        .acciones a:hover {
            color: #0a58ca;
            text-decoration: underline;
        }

    .titulo-tabla {
        font-size: 24px;
        font-weight: 600;
        text-align: center;
        margin-bottom: 25px;
        color: #212529;
    }
</style>