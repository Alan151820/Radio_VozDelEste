@model IEnumerable<RadioVozDelEste.Models.Patrocinadores>

@{
    ViewBag.Title = "Planes de Patrocinio";
}



<h1 class="text-center">Elige tu plan de patrocinio</h1>

<div class="planes-container">
    <div class="plan">
        <h2>Plan Bronce</h2>
        <div class="precio">$5</div>
        <ul class="caracteristicas">
            <li>Acceso a noticias básicas</li>
            <li>Mención mensual</li>
            <li>Boletín especial</li>
        </ul>
        <a href="@Url.Action("Create", "Patrocinadores", new { planId = 1 })" class="btn-subscribe">Suscribirme</a>
    </div>

    <div class="plan">
        <h2>Plan Plata</h2>
        <div class="precio">$20</div>
        <ul class="caracteristicas">
            <li>Contenido exclusivo</li>
            <li>Mención destacada</li>
            <li>Participación en sorteos</li>
        </ul>
        <a href="@Url.Action("Create", "Patrocinadores", new { planId = 2 })" class="btn-subscribe">Suscribirme</a>
    </div>

    <div class="plan">
        <h2>Plan Oro</h2>
        <div class="precio">$50</div>
        <ul class="caracteristicas">
            <li>Publicidad premium</li>
            <li>Logo en portada</li>
            <li>Acceso VIP a eventos</li>
        </ul>
        <a href="@Url.Action("Create", "Patrocinadores", new { planId = 3 })" class="btn-subscribe">Suscribirme</a>
    </div>
</div>

<div class="patrocinadores-container">
    <h3>Patrocinadores actuales</h3>
    <div class="patrocinador-lista">
        @if (Model.Any())
        {
            foreach (var p in Model)
            {
                <div class="patrocinador-card">
                    <strong>@p.Nombre</strong><br />
                    <span>@p.Planes.Nombre</span>
                </div>
            }
        }
        else
        {
            <p>No hay patrocinadores aún.</p>
        }
    </div>
</div>

<style>
    .planes-container {
        display: flex;
        justify-content: center;
        gap: 2rem;
        margin-top: 2rem;
        flex-wrap: wrap;
    }

    .plan {
        border: 2px solid #ccc;
        border-radius: 10px;
        padding: 1.5rem;
        width: 280px;
        background-color: #f9f9f9;
        box-shadow: 2px 2px 10px rgba(0,0,0,0.1);
        text-align: center;
    }

        .plan h2 {
            margin-bottom: 0.5rem;
            color: #333;
        }

        .plan .precio {
            font-size: 2rem;
            color: #007bff;
            margin-bottom: 1rem;
        }

    .caracteristicas {
        text-align: left;
        margin-bottom: 1rem;
    }

        .caracteristicas li {
            margin-bottom: 0.5rem;
        }

    .btn-subscribe {
        background-color: #007bff;
        color: white;
        padding: 0.5rem 1rem;
        border: none;
        border-radius: 5px;
        text-decoration: none;
        font-weight: bold;
    }

    .patrocinadores-container {
        margin-top: 3rem;
    }

        .patrocinadores-container h3 {
            text-align: center;
            margin-bottom: 1rem;
        }

    .patrocinador-lista {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem;
    }

    .patrocinador-card {
        padding: 1rem;
        background-color: #ffffff;
        border: 1px solid #ddd;
        border-radius: 8px;
        width: 220px;
        text-align: center;
    }
</style>
