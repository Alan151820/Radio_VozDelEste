@model List<IGrouping<string, RadioVozDelEste.Models.Noticias>>

@{
    ViewBag.Title = "Inicio";
}
@functions {
    public bool TienePermisoDeAccesoA(string controlador, string accion)
    {
        var permisos = Session["Permisos"] as List<string>;
        return permisos != null && permisos.Contains($"{controlador}.{accion}");
    }
}

@foreach (var grupo in Model)
{
    <h3 class="spanGeneral">
        <a href="@Url.Action("PorCategoria", "Noticias", new { categoria = grupo.Key })" class="TituloCategoriaLink">
            @grupo.Key
        </a>
    </h3>

    <div class="FilaNoticias">
        @foreach (var item in grupo)
        {
            <div class="divNoticia">
                <a href="/Noticias/Details/@item.NoticiaID">
                    <div class="ImagenContainer">
                        <img src="@Url.Content("~/" + item.Imagen)" class="ImagenNoticia" alt="Imagen de la noticia">
                        @if (item.FechaPublicacion.Date >= DateTime.Now.AddDays(-2).Date)
                        {
                            <span class="EtiquetaActual"> ACTUAL</span>
                        }
                        else if (item.FechaPublicacion.Date >= DateTime.Now.AddDays(-7).Date)
                        {
                            <span class="EtiquetaActual"> DESTACADO</span>
                        }
                    </div>
                </a>
                <strong class="ProgramaNoticia">@item.Programas.Nombre.ToUpper()</strong><br />

                <a class="LinkNoticia" href="/Noticias/Details/@item.NoticiaID">
                    <h5 class="TituloNoticia">@item.Titulo</h5>
                </a>


                <p class="card-text">
                    <small class="text-muted">Publicado el: @item.FechaPublicacion.ToShortDateString()</small>
                </p>


                @{
                    var rol = Session["Rol"]?.ToString();
                }

                <div class="botones-noticia" style="margin-top:10px;">
                    @if (TienePermisoDeAccesoA("Noticias", "Edit") || rol == "Administrador" || rol == "Editor")
                    {
                        <a href="@Url.Action("Edit", "Noticias", new { id = item.NoticiaID })" title="Editar" style="margin-right:8px;">
                            <i data-lucide="edit-3" style="width:20px; height:20px; color:#0d6efd;"></i>
                        </a>
                    }
                    @if (TienePermisoDeAccesoA("Noticias", "Delete") || rol == "Administrador" || rol == "Editor")
                    {
                        <a href="@Url.Action("Delete", "Noticias", new { id = item.NoticiaID })" title="Eliminar">
                            <i data-lucide="trash-2" style="width:20px; height:20px; color:#dc3545;"></i>
                        </a>
                    }
                </div>


            </div>

        }
    </div>
}
<script src="https://unpkg.com/lucide@latest"></script>
<script>lucide.createIcons();</script>
<style>

    .spanGeneral {
        margin-top: 60px;
        margin-bottom: 20px;
        padding: 10px 20px;
        background-color: #1e2a78;
        border-left: 6px solid #ffd800;
        font-size: 1.75rem;
        font-weight: bold;
        text-transform: uppercase;
        box-shadow: 0 4px 6px rgba(0,0,0,0.15);
        color: white;
    }

    .TituloCategoriaLink {
        text-decoration: none;
        color: inherit;
        display: block;
        transition: color 0.2s ease;
    }

        .TituloCategoriaLink:hover {
            color: #ffd800;
        }


    .divNoticia {
        width: 100%;
        max-width: 30%;
    }

    .FilaNoticias {
        display: flex;
        flex-wrap: wrap;
        gap: 30px
    }

    .ProgramaNoticia {
        font-family: 'Malgun Gothic';
        color: #2d36de;
    }

    .TituloNoticia {
        font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
    }

    .LinkNoticia {
        text-decoration: none;
        color: inherit;
        display: block;
    }

    .ImagenContainer {
        position: relative;
    }

    .ImagenNoticia {
        width: 100%;
        height:100%;
        border-radius: 5px;
    }

    .EtiquetaActual {
        position: absolute;
        top: 10px;
        right: 10px;
        background-color: #ffd800;
        color: #fff;
        padding: 4px 10px;
        font-size: 0.75rem;
        font-weight: bold;
        border-radius: 5px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.25);
    }

    .divNoticia {
        transition: all 0.3s ease-in-out;
    }

        .divNoticia:hover .ImagenNoticia {
            filter: grayscale(100%);
            cursor: pointer;
        }

        .divNoticia:hover .TituloNoticia {
            cursor: pointer;
        }

    
</style>



