@model IEnumerable<IGrouping<string, RadioVozDelEste.Models.Horarios>>

@{
    ViewBag.Title = "Index";
}
@{
    var rol = Session["Rol"].ToString();
}

@foreach (var grupo in Model)
{
    <h2 class="nombreDia">@grupo.Key.ToUpper() </h2>
    <div class="CadaTabla">
        <table class="table">
            <thead>
                <tr>
                    <th class="columnaHora">INCIO</th>
                    <th class="columnaPrograma">PROGRAMA</th>
                    <th></th>
                </tr>
            </thead>
            @foreach (var horario in grupo)
            {

                <tr>
                    <td class="HoraPrograma">@horario.HoraInicio </td>

                    <td class="InfoPrograma">
                        <span class="NombrePrograma"> @Html.ActionLink(horario.Programas.Nombre.ToUpper(), "Details", new { id = horario.HorarioID })</span>

                        <div class="Conductores">

                            <span class="spanConductores">Conductores :</span>

                            @foreach (var conductor in horario.Programas.Conductores)
                            {
                                <span class="Chip">@conductor.Nombre </span>
                            }
                        </div>

                    </td>
                    <td class="edicion">
                        @if (rol == "Administrador")
                        {

                            @Html.ActionLink("Edit", "Edit", new { id = horario.HorarioID } ) <span>  | </span> 
                            @Html.ActionLink("Delete", "Delete", new { id = horario.HorarioID })

                        }
                    </td>

                </tr>
            }
        </table>

    </div>
}

<style>
    .btn-container {
        text-align: right;
        padding-right: 60px;
    }

    .btnCrearHorario {
        color: black;
        border: 1px solid #bbd50c;
        padding: 8px 16px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        background-color: transparent;
        display: inline-block;
    }

        .btnCrearHorario:hover {
            background-color: #c1c1c1;
            color: black;
            zoom: 1.03;
        }


    .container {
        margin-top: 0;
        padding: 0;
    }S
    th, td {
        border-bottom: none;
    }


    .CadaTabla {
        background-color: #f5f5f5;
        width: 100%;
    }

    .Conductores {
        display: block;
        padding-top: 5px;
    }

    .NombrePrograma {
        font-weight: bold;
        color: black;
        border: none;
        font-size: 18px;
    }

        .NombrePrograma a {
            font-weight: 700;
            color: #071253;
            text-decoration: none;
        }

            .NombrePrograma a:hover {
                text-decoration: underline;
                color: #bbd50c
            }

    .nombreDia {
        color: #bbd50c;
        font-style: revert;
        font-weight: bold;
        margin-left: 89px;
        margin-bottom: 0;
        margin-top: 30px;
        border-left: 1px #ccc solid;
        padding-left: 10px;
    }

    .columnaHora {
        color: #4346ce;
        border-right: 1px #ccc solid;
    }

    .columnaPrograma {
        color: #4346ce;
    }

    .HoraPrograma {
        font-weight: 500;
        border-right: 1px solid #ccc;
        width: 90px;
        border-top: 1px solid #ccc
    }

    .InfoPrograma, .edicion {
        border-top: 1px solid #ccc
    }

    .table th {
        padding: 10px;
        background-color: #e0e0e0;
    }

    .spanConductores {
        font-weight: 600;
        font-size: 14px;
    }


    .Chip {
        display: inline-block;
        background-color: #e0f0ff;
        color: #005ea2;
        padding: 5px 10px;
        border-radius: 15px;
        margin: 2px;
        font-size: 13px;
        font-weight: 400;
        box-shadow: 1px 1px 3px rgba(0,0,0,0.1);
    }
</style>

