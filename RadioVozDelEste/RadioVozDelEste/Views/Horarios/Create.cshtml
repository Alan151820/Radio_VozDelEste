@model RadioVozDelEste.Models.Horarios

@{
    ViewBag.Title = "Crear Horario";
}

<h2>Crear Horario</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

<div class="form-horizontal">
    <h4>Horarios</h4>
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="form-group">
        @Html.LabelFor(model => model.ProgramaID, "Programa", htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.DropDownList("ProgramaID", null, "-- Seleccione Programa --", new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.ProgramaID, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.DiaID, "Dia", htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.DropDownList("DiaID", null, "-- Seleccione Día --", new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.DiaID, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.Label("HoraInicio", "Hora Inicio", htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.HoraInicio, new { htmlAttributes = new { @class = "form-control", type = "time" } })
            @Html.ValidationMessageFor(model => model.HoraInicio, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.Label("HoraFin", "Hora Fin", htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.HoraFin, new { htmlAttributes = new { @class = "form-control", type = "time" } })
            @Html.ValidationMessageFor(model => model.HoraFin, "", new { @class = "text-danger" })
        </div>
    </div>


    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Crear" class="btn btn-default" />
        </div>
    </div>
</div>
}

<style>
    body {
        background-color: #f4f6f9;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    h2, h4 {
        color: #0d2c54;
        text-align: center;
        margin-top: 20px;
        font-weight: 600;
    }

    .form-horizontal {
        background: white;
        padding: 30px;
        margin: 40px auto;
        max-width: 600px;
        border-radius: 12px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
    }

    .control-label {
        font-weight: 600;
        color: #2c3e50;
        padding-top: 10px;
        display: block;
        margin-bottom: 6px;
    }

    .form-group {
        margin-bottom: 20px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
    }

    .col-md-2 {
        flex: 0 0 25%;
        max-width: 25%;
        text-align: right;
        padding-right: 15px;
        box-sizing: border-box;
    }

    .col-md-10 {
        flex: 1 1 70%;
        max-width: 70%;
    }

    .form-control {
        width: 100%;
        border-radius: 6px;
        border: 1px solid #ced4da;
        padding: 10px 14px;
        font-size: 15px;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

        .form-control:focus {
            border-color: #0051ba;
            box-shadow: 0 0 0 0.2rem rgba(0, 81, 186, 0.25);
            outline: none;
        }

    .btn.btn-default {
        background-color: #0051ba;
        color: white;
        font-weight: 600;
        padding: 10px 24px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

        .btn.btn-default:hover {
            background-color: #003f94;
        }

    .text-danger {
        font-size: 0.9rem;
        margin-top: 4px;
        color: #d9534f;
    }

    hr {
        border: none;
        height: 2px;
        background: #0051ba;
        margin-bottom: 30px;
    }

    .back-link {
        margin-left: 20px;
        font-weight: bold;
        color: #0051ba;
        text-decoration: none;
    }

        .back-link:hover {
            text-decoration: underline;
        }
</style>
