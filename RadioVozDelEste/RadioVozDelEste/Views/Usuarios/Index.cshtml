@model IEnumerable<RadioVozDelEste.Models.Usuarios>

@{
    ViewBag.Title = "Listado de Usuarios";
}

<div class="container mt-5">
    <h2 class="titulo-tabla">Listado de Usuarios</h2>

    <div class="table-responsive tabla-programas">
        <table class="table align-middle table-hover mb-0">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in Model)
                {
                    <tr>
                        <td>@usuario.Nombre</td>
                        <td>@usuario.Email</td>
                        <td class="acciones">
                            @Html.ActionLink("Detalles", "Details", new { id = usuario.UsuarioID }) |
                            @Html.ActionLink("Asignar Permisos", "EditarPermisos", "Usuarios", new { id = usuario.UsuarioID }, null)|
                            @Html.ActionLink("Eliminar", "Delete", new { id = usuario.UsuarioID })

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .tabla-programas {
        background-color: #fff;
        border-radius: 12px;
        box-shadow: 0 6px 24px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

        .tabla-programas th {
            background-color: #0d6efd;
            color: white;
            font-weight: 600;
            text-align: center;
            vertical-align: middle;
            font-size: 16px;
        }
     
        .tabla-programas td {
            vertical-align: middle;
            font-size: 15px;
            color: #333;
            text-align: center; /* ← Esto centra todo por defecto */
        }

    .acciones a {
        margin-right: 8px;
        text-decoration: none;
        color: #0d6efd;
        font-weight: 500;
        transition: color 0.2s ease;
    }

        .acciones a:hover {
            color: #0a58ca;
            text-decoration: underline;
        }

    .titulo-tabla {
        font-size: 24px;
        font-weight: 600;
        text-align: center;
        margin-bottom: 25px;
        color: #212529;
    }
</style>
