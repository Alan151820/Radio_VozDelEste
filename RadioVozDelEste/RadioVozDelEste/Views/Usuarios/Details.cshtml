@model RadioVozDelEste.Models.Usuarios

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Detalles de Usuario</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="card p-4">
        <div class="card-header mb-3">
            Detalles del Usuario
        </div>
        <dl class="row">
            <dt class="col-sm-4">Nombre</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Nombre)</dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Email)</dd>

            <dt class="col-sm-4">Rol</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Roles.Nombre)</dd>

            <dt class="col-sm-4">Permisos</dt>
            <dd class="col-sm-8">
                <ul>
                    @foreach (var permiso in Model.Permisos)
                    {
                        <li>@permiso.Descripcion</li>
                    }
                </ul>
            </dd>
        </dl>
        <div class="btn-group mt-3">
            @Html.ActionLink("Editar", "Edit", new { id = Model.UsuarioID }, new { @class = "btn btn-primary" })
            @Html.ActionLink("Volver al listado", "Index", null, new { @class = "btn btn-secondary" })
        </div>
    </div>
</body>
</html>
<style>
    body {
        background-color: #f8f9fa;
        padding: 2rem;
    }

    .card {
        max-width: 600px;
        margin: 2rem auto;
        box-shadow: 0 4px 8px rgba(0,0,0,.05);
        border-radius: 0.5rem;
        background: white;
    }

    .card-header {
        font-weight: 700;
        font-size: 1.5rem;
        color: #0d6efd;
    }

    dt {
        font-weight: 600;
        color: #495057;
    }

    dd {
        margin-bottom: 1rem;
    }

    ul {
        padding-left: 1.2rem;
    }

    .btn-group a {
        margin-right: 0.5rem;
    }
</style>
