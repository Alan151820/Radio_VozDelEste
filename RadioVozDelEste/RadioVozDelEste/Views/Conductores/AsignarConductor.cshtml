@{
    ViewBag.Title = "Asignar Conductor a Programa";
}

<h2>Asignar Conductor a Programa</h2>

@using (Html.BeginForm("AsignarConductor", "Conductores", FormMethod.Post))
{
    <div class="form-group">
        @Html.Label("Programa")
        @Html.DropDownList("ProgramaID", (SelectList)ViewBag.Programas, "Selecciona un programa", new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.Label("Conductor")
        @Html.DropDownList("conductorId", (SelectList)ViewBag.Conductores, "Selecciona un conductor", new { @class = "form-control" })
    </div>

    <button type="submit" class="btn btn-primary">Asignar</button>
}
