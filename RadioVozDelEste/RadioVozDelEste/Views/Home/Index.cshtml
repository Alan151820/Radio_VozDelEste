<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://unpkg.com/lucide@latest"></script>

@functions {
    public bool TienePermisoDeAccesoA(string controlador, string accion)
    {
        var permisos = Session["Permisos"] as List<string>;
        return permisos != null && permisos.Contains($"{controlador}.{accion}");
    }
}

@{
    var rol = Session["Rol"]?.ToString();
}


<div class="container my-5">
    <h2 class="text-center mb-4">Panel de Administración</h2>
    <div class="row g-4 justify-content-center">
        @if (TienePermisoDeAccesoA("Programas", "Create") || rol == "Administrador")
        {

            <div class="col-md-4">
                <a href="/Programas/Create" class="text-decoration-none">
                    <div class="card text-center shadow-lg border-0 rounded-4 h-100">
                        <div class="card-body py-4">
                            <i data-lucide="plus-circle" class="mb-3" style="width: 40px; height: 40px;"></i>
                            <h5 class="card-title">Crear Programa</h5>
                            <p class="card-text">Agrega un nuevo programa.</p>
                        </div>
                    </div>
                </a>
            </div>
        }

        @if (TienePermisoDeAccesoA("Programas", "Index") || rol == "Administrador")
        {
            <div class="col-md-4">
                <a href="/Programas/Index" class="text-decoration-none">
                    <div class="card text-center shadow-lg border-0 rounded-4 h-100">
                        <div class="card-body py-4">
                            <i data-lucide="trash-2" class="mb-3" style="width: 40px; height: 40px;"></i>
                            <h5 class="card-title">Admnistrar Programas</h5>
                            <p class="card-text">Mira, edita o elimina programas.</p>
                        </div>
                    </div>
                </a>
            </div>
        }

